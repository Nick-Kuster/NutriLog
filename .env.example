VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional, dev-only: auto sign-in on localhost so the app doesn't sit on the login screen.
# Never set these outside a local .env file - they are ignored in production builds.
VITE_DEV_AUTH_EMAIL=
VITE_DEV_AUTH_PASSWORD=
